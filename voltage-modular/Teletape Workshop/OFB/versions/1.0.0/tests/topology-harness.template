// Independent ideal analog circuit evaluation, with each section prewarped to 48 kHz.
static double[] expected(int band,double frequency){
 double fH=1/(2*Math.PI*HP_CAPACITORS[band]*Math.sqrt(HP_RESISTOR_SMALL[band]*HP_RESISTOR_LARGE[band]));
 double fL=1/(2*Math.PI*LP_RESISTORS[band]*Math.sqrt(LP_FEEDBACK_CAPACITORS[band]*LP_GROUND_CAPACITORS[band]));
 double qH=Math.sqrt(HP_RESISTOR_LARGE[band]/HP_RESISTOR_SMALL[band])/2;
 double qL=Math.sqrt(LP_FEEDBACK_CAPACITORS[band]/LP_GROUND_CAPACITORS[band])/2;
 double u=Math.tan(Math.PI*frequency/48000)/Math.tan(Math.PI*fH/48000),v=Math.tan(Math.PI*frequency/48000)/Math.tan(Math.PI*fL/48000);
 double ar=1-u*u,ai=u/qH,br=1-v*v,bi=v/qL;
 double dr=ar*br-ai*bi,di=ar*bi+ai*br,scale=-u*u/(dr*dr+di*di);
 return new double[]{scale*dr,-scale*di};
}
static double[] resamplerResponse(double frequency) {
 double[] c={.021277660466073,0,-.027992303277934,0,.049537687283950,0,-.095789590456413,0,.308510413777763,.488912264413122,.308510413777763,0,-.095789590456413,0,.049537687283950,0,-.027992303277934,0,.021277660466073};
 double real=0,imaginary=0;
 for(int branch=0;branch<2;branch++){double ar=0,ai=0;double w=2*Math.PI*frequency/96000+branch*Math.PI;for(int i=0;i<c.length;i++){ar+=c[i]*Math.cos(w*i);ai-=c[i]*Math.sin(w*i);}real+=ar*ar-ai*ai;imaginary+=2*ar*ai;}
 return new double[]{real*RESAMPLER_DC_NORMALIZATION,imaginary*RESAMPLER_DC_NORMALIZATION};
}
static double alias(boolean oversampled) {
 HalfBand19 up=new HalfBand19(),down=new HalfBand19();double re=0,im=0;
 for(int i=0;i<96000;i++){double x=24*Math.sin(2*Math.PI*9000*i/48000),y;if(oversampled){double a=up.process(2*x),b=up.process(0);y=down.process(shapeMix(a))*RESAMPLER_DC_NORMALIZATION;down.process(shapeMix(b));}else y=shapeMix(x);if(i>=48000){re+=y*Math.sin(2*Math.PI*3000*i/48000)/24000;im+=y*Math.cos(2*Math.PI*3000*i/48000)/24000;}}
 return Math.hypot(re,im);
}
