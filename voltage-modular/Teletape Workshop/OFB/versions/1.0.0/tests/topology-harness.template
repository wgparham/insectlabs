m.inputAudio.v=2;m.process();double history=m.highPass[0].y1,smoothed=m.smoothedGains[0];int reads=m.gainKnobs[0].reads;m.bypass();near(m.outputAudio.v,2,1e-12,"direct bypass");near(m.highPass[0].y1,history,1e-12,"bypass frozen");near(m.smoothedGains[0],smoothed,1e-12,"gain frozen");check(m.gainKnobs[0].reads==reads,"no bypass knob reads");for(VoltageAudioJack j:m.individualOuts)near(j.v,0,1e-12,"silent taps in bypass");
m.inputAudio.v=0;m.process();near(m.outputAudio.v,0,1e-12,"resume clears stale energy");m.inputAudio.v=1;m.process();m.resetPending.set(true);m.inputAudio.v=0;m.process();near(m.outputAudio.v,0,1e-12,"reset clears energy");m.inputAudio.v=Double.NaN;m.process();check(Double.isFinite(m.outputAudio.v),"input NaN recovery");m.highPass[0].y1=Double.NaN;m.lowPass[1].y1=Double.NaN;m.gainKnobs[2].v=Double.NaN;m.process();check(Double.isFinite(m.outputAudio.v),"state/gain recovery");
near(shapeMix(0),0,1e-12,"shape zero");near(shapeMix(1e-6),1e-6,1e-12,"unity tiny signal");double prior=0;for(int i=0;i<=10000;i++){double x=i/100.0,y=shapeMix(x);check(y>=prior&&y<=12,"bounded monotonic shaping");near(shapeMix(-x),-y,1e-12,"odd symmetry");prior=y;}check(shapeMix(5)/5>.99,"ordinary level clarity");check(shapeMix(24)/24<.5,"driven compression");check(Double.isFinite(shapeMix(Double.MAX_VALUE)),"extreme finite shape");
m.inputAudio.v=Double.MAX_VALUE;for(int i=0;i<30;i++)m.process();m.inputAudio.v=0;for(int i=0;i<100;i++)m.process();check(Double.isFinite(m.outputAudio.v),"FIR recovery after extreme input");
