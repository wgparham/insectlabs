// Independent ideal analog circuit evaluation, with each section prewarped to 48 kHz.
static double[] expected(int band,double frequency){
 double fH=1/(2*Math.PI*HP_CAPACITORS[band]*Math.sqrt(HP_RESISTOR_SMALL[band]*HP_RESISTOR_LARGE[band]));
 double fL=1/(2*Math.PI*LP_RESISTORS[band]*Math.sqrt(LP_FEEDBACK_CAPACITORS[band]*LP_GROUND_CAPACITORS[band]));
 double qH=Math.sqrt(HP_RESISTOR_LARGE[band]/HP_RESISTOR_SMALL[band])/2;
 double qL=Math.sqrt(LP_FEEDBACK_CAPACITORS[band]/LP_GROUND_CAPACITORS[band])/2;
 double u=Math.tan(Math.PI*frequency/48000)/Math.tan(Math.PI*fH/48000),v=Math.tan(Math.PI*frequency/48000)/Math.tan(Math.PI*fL/48000);
 double ar=1-u*u,ai=u/qH,br=1-v*v,bi=v/qL;
 double dr=ar*br-ai*bi,di=ar*bi+ai*br,scale=-u*u/(dr*dr+di*di);
 return new double[]{scale*dr,-scale*di};
}
