near(mixGainForKnob(0),0,0.0000000001,"CCW mute");near(mixGainForKnob(1),1,0.0000000001,"CW full");double previous=0;for(int i=0;i<=1000;i++){double g=mixGainForKnob(i/1000.0);check(g>=previous&&g>=0&&g<=1,"bounded monotonic log law");previous=g;}
// Check level changes do not touch direct taps and linear input scaling has no tanh.
