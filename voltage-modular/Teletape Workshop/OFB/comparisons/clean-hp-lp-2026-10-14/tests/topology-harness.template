m.inputAudio.v=0;m.process();near(m.outputAudio.v,0,1e-12,"resume clears stale energy");m.inputAudio.v=1;m.process();m.resetPending.set(true);m.inputAudio.v=0;m.process();near(m.outputAudio.v,0,1e-12,"reset clears energy");m.inputAudio.v=Double.NaN;m.process();check(Double.isFinite(m.outputAudio.v),"input NaN recovery");m.highPass[0].y1=Double.NaN;m.lowPass[1].y1=Double.NaN;m.gainKnobs[2].v=Double.NaN;m.process();check(Double.isFinite(m.outputAudio.v),"state/gain recovery");
System.out.println("PASS: DC, log endpoints/monotonicity, input linearity, raw taps, smoothed mute, bypass/state/reset/numerical recovery");
