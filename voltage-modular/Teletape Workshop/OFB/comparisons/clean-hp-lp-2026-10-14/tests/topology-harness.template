 for(int i=0;i<96000;i++){double sine=Math.sin(2*Math.PI*frequency*i/48000),cosine=Math.cos(2*Math.PI*frequency*i/48000);m.inputAudio.v=sine;m.process();if(i>=48000){for(int b=0;b<8;b++){re[b]+=m.individualOuts[b].v*sine/24000;im[b]+=m.individualOuts[b].v*cosine/24000;}mr+=m.outputAudio.v*sine/24000;mi+=m.outputAudio.v*cosine/24000;}}
 double er=0,ei=0;for(int b=0;b<8;b++){double[] e=expected(b,frequency);near(re[b],e[0],2e-7,"band real response");near(im[b],e[1],2e-7,"band imaginary response");er+=MIX_POLARITY[b]*e[0];ei+=MIX_POLARITY[b]*e[1];}
 near(mr,er,2e-7,"alternating main real");near(mi,ei,2e-7,"alternating main imaginary");System.out.printf(java.util.Locale.ROOT,"PASS %.0f Hz: all taps and phase-correct mix; main gain %.3f dB%n",frequency,20*Math.log10(Math.hypot(mr,mi)));
}
