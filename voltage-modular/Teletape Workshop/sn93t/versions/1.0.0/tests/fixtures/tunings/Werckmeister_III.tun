[Info]
Name = "Werckmeister III"
ID = "WerckmeisterIII"
Filename = "Werckmeister_III"
Author = "Andreas Werckmeister"
Description = "Well temperament III; A4 anchored to 440 Hz. Exact cents from C repeat every octave."
History = "Four fifths are narrowed by one quarter of the Pythagorean comma; the other eight fifths are pure."
Comments = "This test file includes Exact Tuning data for SN93T and Functional Tuning data for AnaMark v2 compatibility."

