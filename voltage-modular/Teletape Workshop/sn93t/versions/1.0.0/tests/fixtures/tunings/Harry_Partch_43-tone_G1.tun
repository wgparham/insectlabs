[Info]
Name = "Harry Partch 43-tone just scale"
ID = "Partch43"
Filename = "Harry_Partch_43-tone_G1"
Author = "Harry Partch"
Description = "43-tone 11-limit just scale, represented as consecutive scale degrees across MIDI note numbers."
History = "The ratios follow the Partch 43-tone scale, from 1/1 through 160/81; every 43 MIDI steps is one octave."
Comments = "For SN93T testing: MIDI note 0 anchors 1/1 at G1 (49 Hz), so the represented range is approximately G1 to G4."

