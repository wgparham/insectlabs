[Info]
Name = "Wendy Carlos Alpha"
ID = "CarlosAlpha"
Filename = "Wendy_Carlos_Alpha_78c"
Author = "Wendy Carlos"
Description = "Non-octaving equal-step Alpha tuning, 78.0 cents per keyboard step."
History = "Carlos describes Alpha as approximately 15.385 steps per octave, with no exact octave repetition."
Comments = "For SN93T testing: each successive MIDI note rises by 78 cents; the A4 reference control transposes the whole tuning."

